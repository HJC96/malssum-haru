{
  "name": "malssum-haru",
  "private": true,
  "packageManager": "pnpm@9.4.0",
  "engines": { "node": ">=20.19.0" },
  "description": "말씀하루 — 워크스페이스 루트. 실행은 각 패키지 스크립트를 사용한다(web, infra). services/qt는 Maven.",
  "scripts": {
    "dev:qt:links": "mvn -f services/qt/pom.xml spring-boot:run",
    "dev:qt:live": "mvn -f services/qt/pom.xml spring-boot:run -Dspring-boot.run.profiles=local-experiment",
    "dev:web:api": "VITE_QT_SOURCE=api pnpm --filter malssum-haru-web dev"
  }
}
